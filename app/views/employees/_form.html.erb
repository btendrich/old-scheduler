<%= form_with model: employee do |form| %>
  <%= render "shared/errors", record: employee %>

  <%= form.label :last_name %>
  <%= form.text_field :last_name, required: true, autocomplete: "family-name" %>

  <%= form.label :first_name %>
  <%= form.text_field :first_name, required: true, autocomplete: "given-name" %>

  <%= form.label :preferred_name, "Preferred name" %>
  <%= form.text_field :preferred_name, autocomplete: "nickname" %>

  <%= form.label :mobile %>
  <%= form.telephone_field :mobile, required: true %>

  <%= form.label :email %>
  <%= form.email_field :email %>

  <%= form.label :notes %>
  <%= form.text_area :notes, rows: 3 %>

  <%= form.label :active, "Active" %>
  <%= form.check_box :active %>

  <p><%= form.submit %></p>
<% end %>
