<% content_for :title, "Employees" %>
<h1>Employees</h1>
<p><%= link_to "New employee", new_employee_path %></p>

<% if @employees.any? %>
  <table>
    <thead>
      <tr>
        <th>Order</th>
        <th>Name</th>
        <th>Mobile</th>
        <th>Skills</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @employees.each do |employee| %>
        <tr class="<%= "inactive" unless employee.active? %>">
          <td>
            <%= button_to "Up", move_higher_employee_path(employee), method: :patch %>
            <%= button_to "Down", move_lower_employee_path(employee), method: :patch %>
          </td>
          <td>
            <%= link_to employee.preferred_name, employee %>
            <% if employee.legal_name.present? && employee.legal_name != employee.preferred_name %>
              <span class="muted"><%= employee.legal_name %></span>
            <% end %>
          </td>
          <td><%= employee.mobile %></td>
          <td>
            <%= employee.skills_in_order.map { |row| "#{row.skill.name} #{row.level}" }.join(", ") %>
          </td>
          <td><%= "Inactive" unless employee.active? %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No employees yet.</p>
<% end %>
