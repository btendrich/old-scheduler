<% content_for :title, "Skills" %>
<%= page_header "Skills", lede: "Categories group the skills used to build a fill list." %>

<%= form_with model: @category, class: "mb-8 flex flex-wrap items-end gap-2" do |form| %>
  <%= form.text_field :name, placeholder: "New category", required: true, aria: { label: "New category" } %>
  <%= form.submit "Add category", class: "mt-0" %>
<% end %>

<% if @categories.any? %>
  <% @categories.each do |category| %>
    <section class="card mb-4">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h2 class="mt-0"><%= category.name %></h2>
        <p class="flex items-center gap-2">
          <%= link_to "Edit", edit_skill_category_path(category) %>
          <%= button_to "Delete", category, method: :delete %>
        </p>
      </div>
      <% if category.skills.any? %>
        <ul class="rows">
          <% category.skills.each do |skill| %>
            <li>
              <span class="font-medium"><%= skill.name %></span>
              <%= link_to "Edit", edit_skill_path(skill), class: "ml-auto" %>
              <%= button_to "Delete", skill, method: :delete %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="muted mt-2">No skills in this category.</p>
      <% end %>
      <%= form_with model: [ category, Skill.new ], class: "mt-3 flex flex-wrap items-end gap-2" do |form| %>
        <%= form.text_field :name, placeholder: "New skill", required: true, aria: { label: "New skill in #{category.name}" } %>
        <%= form.submit "Add skill", class: "mt-0" %>
      <% end %>
    </section>
  <% end %>
<% else %>
  <p class="text-stone-500">No skill categories yet.</p>
<% end %>
