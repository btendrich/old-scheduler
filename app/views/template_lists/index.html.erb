<% content_for :title, "Lists" %>
<%= page_header "Lists", lede: "The venue's lists. One of them is the default a call opens on." %>

<section class="card mb-6">
  <ul class="m-0 list-none p-0">
    <li>
      <p class="font-semibold"><%= venue.name %></p>
      <% if @lists.any? %>
        <ul class="skill-branches">
          <% @lists.each do |list| %>
            <li>
              <%= link_to template_lists_path(list: list.id), class: "list-tree-link", aria: { current: ("page" if @selected == list) } do %>
                <span class="truncate"><%= list.name %></span>
                <% if list.default? %><span class="list-default">Default</span><% end %>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="muted mt-2">No lists yet.</p>
      <% end %>
    </li>
  </ul>
  <%= form_with model: @draft, class: "mt-4 flex flex-wrap items-end gap-2" do |form| %>
    <%= form.label :name, "New list", class: "mt-0 w-full" %>
    <%= form.text_field :name, required: true %>
    <%= form.submit "Add list", class: "mt-0" %>
  <% end %>
</section>

<% if @selected %>
  <%= render "editor", list: @selected, available: @available, members: @members, categories: @categories, roster: @roster, work: @work %>
<% end %>
