<% content_for :title, @call.show.name %>
<div class="call-page">
  <p class="text-sm"><%= link_to @call.show.name, @call.show, class: "no-underline hover:underline" %></p>
  <%= page_header @call.show.name, lede: "#{@call.location.name} · #{@call.call_type.name}" do %>
    <%= link_to "Edit", edit_call_path(@call), class: "btn-primary" %>
    <%= button_to "Delete", @call, method: :delete %>
  <% end %>

  <%= render "progress" %>
  <%= render "summary" %>

  <div class="call-desk" data-controller="call-desk" data-call-desk-call-id-value="<%= @call.id %>">
    <%= render "slots" %>
    <%= render "fill" %>
  </div>

  <section class="call-audit">
    <h2>Audit</h2>
    <div class="call-audit-frame">
      <%= render "audit_log", call: @call %>
    </div>
  </section>
</div>
