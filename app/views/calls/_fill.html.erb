<section class="fill-column">
  <div data-call-desk-target="panel" data-panel="summary">
    <h2 class="mt-0">Fills</h2>
    <% if @fill_processes.any? %>
      <ul class="rows">
        <% @fill_processes.each do |process| %>
          <li class="fill-card flex-col items-stretch" data-call-desk-target="processCard" data-process-id="<%= process.id %>">
            <div class="flex min-w-0 flex-wrap items-center gap-2">
              <button type="button" class="flex min-w-0 flex-1 flex-col items-start border-0 bg-transparent p-0 text-left shadow-none" data-action="call-desk#pick" data-call-desk-kind-param="fill:<%= process.id %>">
                <span class="font-medium"><%= process.number %> · <%= process.slot_tally %></span>
                <span class="mt-1 flex flex-wrap items-center gap-2">
                  <%= fill_phase_badge(process) %>
                  <span class="text-sm text-stone-500"><%= process.synopsis %><%= " · first response" if process.emergency? %></span>
                </span>
              </button>
              <%= form_with url: add_slots_fill_process_path(process), class: "m-0 shrink-0", data: { call_desk_target: "addSlots" }, html: { hidden: true } do %>
                <div data-call-desk-target="slotFields"></div>
                <%= submit_tag "Add to this fill", class: "mt-0" %>
              <% end %>
              <% if process.running? %>
                <%= button_to "Stop", stop_fill_process_path(process), form: { class: "m-0", data: { turbo_confirm: process.stop_warning }.compact } %>
              <% elsif process.status == "pending" %>
                <%= button_to "Start", start_fill_process_path(process), class: "btn-primary border-0", form: { class: "m-0" } %>
              <% end %>
            </div>
            <%= render "process", process: process %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-stone-500">No fill is running for this call.</p>
    <% end %>
  </div>

  <div data-call-desk-target="panel" data-panel="create" hidden>
    <h2 class="mt-0">New fill</h2>
    <p class="text-sm text-stone-600">Slots: <span data-call-desk-target="createSummary"></span></p>
    <%= form_with model: [ @call, FillProcess.new(offer_timeout_minutes: 60, step_size: 5, step_minutes: 10) ] do |form| %>
      <div data-call-desk-target="slotFields"></div>
      <%= form.label :offer_timeout_minutes, "Minutes before an offer times out" %>
      <%= form.number_field :offer_timeout_minutes, min: 1 %>
      <%= form.label :mode, "First-response fill" %>
      <%= form.check_box :mode, {}, "emergency", "normal" %>
      <%= form.label :step_size, "People texted each step" %>
      <%= form.number_field :step_size, min: 1 %>
      <%= form.label :step_minutes, "Minutes before the next step" %>
      <%= form.number_field :step_minutes, min: 1 %>
      <%= form.label :custom_window, "Use a custom send window" %>
      <%= form.check_box :custom_window %>
      <%= form.label :window_start, "Window starts" %>
      <%= form.time_field :window_start %>
      <%= form.label :window_end, "Window ends" %>
      <%= form.time_field :window_end %>
      <%= form.submit "Create a fill", class: "mt-4" %>
    <% end %>
    <p class="muted">Leave the window blank to use the venue hours. Matching start and end means all day.</p>
  </div>

  <% @call.call_slots.each do |slot| %>
    <% if (assignment = slot.current_assignment) %>
      <%= render "assignment", slot: slot, assignment: assignment %>
    <% end %>
  <% end %>

</section>
