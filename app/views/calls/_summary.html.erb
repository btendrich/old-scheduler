<section class="card mb-6">
  <p class="mt-0">
    <%= @call.show.client.name %>'s <%= @call.show.name %>,
    <%= venue_time(@call.starts_at) %> – <%= venue_time(@call.ends_at) %>.
  </p>
  <h2 class="mt-4 text-sm">To review</h2>
  <% items = @call.review_items %>
  <% if items.any? %>
    <ul class="mt-2 list-disc pl-5 text-sm">
      <% items.each do |item| %>
        <li><%= item %></li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-sm text-stone-500">Nothing to review.</p>
  <% end %>
</section>
