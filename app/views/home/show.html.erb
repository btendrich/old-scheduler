<% content_for :title, Current.user.venue.name %>

<header class="mb-6">
  <h1><%= Current.user.venue.name %></h1>
  <p class="mt-1 text-sm text-stone-500">Venue time <time class="font-medium text-stone-800 tabular-nums"><%= Time.current.strftime("%-I:%M %p %Z") %></time></p>
</header>

<% if @days.empty? %>
  <p class="text-stone-500">No upcoming calls.</p>
<% else %>
  <% @days.each do |day, calls| %>
    <section>
      <h2 class="text-xs font-semibold tracking-wide text-stone-500 uppercase"><%= day.strftime("%A, %b %-d") %></h2>
      <ul class="rows">
        <% calls.each do |call| %>
          <li>
            <%= link_to call.show.name, call, class: "font-medium text-stone-950 no-underline hover:text-sky-800 hover:no-underline" %>
            <span class="text-sm text-stone-600 tabular-nums">
              <% if call.starts_at.to_date == call.ends_at.to_date %>
                <%= call.starts_at.strftime("%-I:%M %p") %>–<%= call.ends_at.strftime("%-I:%M %p") %>
              <% else %>
                <%= venue_time(call.starts_at) %>–<%= venue_time(call.ends_at) %>
              <% end %>
            </span>
            <span class="text-sm text-stone-500"><%= call.location.name %></span>
            <span class="ml-auto text-sm text-stone-600 tabular-nums"><%= call.filled_slot_count %> of <%= call.call_slots.size %> filled</span>
            <%= status_badge("Needs review") if call.needs_review? %>
            <%= status_badge("Needs more names") if call.needs_more_names? %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
<% end %>
