<% content_for :title, "Assign #{@slot.label_name}" %>
<p class="text-sm"><%= link_to "Back to call", @call, class: "no-underline hover:underline" %></p>
<%= page_header "Assign #{@slot.label_name}", lede: "#{venue_time(@call.starts_at)} – #{venue_time(@call.ends_at)}" %>

<%= render "shared/errors", record: @assignment %>

<div class="overflow-hidden rounded-lg bg-white ring-1 ring-stone-200">
  <table>
    <thead>
      <tr>
        <th>Person</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
      <% @availabilities.each do |row| %>
        <tr>
          <td class="<%= "inactive" unless row.employee.active? %>"><%= row.employee.name %></td>
          <td><%= status_badge(row.label) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<% placeable = @availabilities.select(&:placeable?) %>
<% if placeable.any? %>
  <%= form_with model: [ @slot, @assignment ], class: "card mt-6" do |form| %>
    <%= form.label :employee_id, "Person", class: "mt-0" %>
    <%= form.select :employee_id, placeable.map { |row| [ row.option_label, row.employee.id ] }, include_blank: "Choose a person" %>
    <%= form.label :confirmation, "Confirmation" %>
    <%= form.select :confirmation, Assignment.confirmation_choices %>
    <%= form.label :note, "Note" %>
    <%= form.text_field :note %>
    <%= form.submit "Assign" %>
  <% end %>
<% else %>
  <p class="mt-4 text-stone-500">Everyone listed is already on this call.</p>
<% end %>
